# Docker Compose local-development settings only.
# This Compose stack uses PostgreSQL trust authentication inside its private
# development network, so no database password belongs in this file.
COMPOSE_PROJECT_NAME=unified-commerce
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
POSTGRES_DB=unified_commerce
POSTGRES_USER=unified_commerce
CORS_ORIGINS=http://localhost:3000

