{
  "name": "unified-commerce",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @unified-commerce/api && npm run build --workspace @unified-commerce/web",
    "test": "npm run test --workspace @unified-commerce/api && npm run test --workspace @unified-commerce/web",
    "dev:api": "npm run dev --workspace @unified-commerce/api",
    "dev:web": "npm run dev --workspace @unified-commerce/web",
    "db:migrate": "npm run db:migrate --workspace @unified-commerce/api",
    "db:seed": "npm run db:seed --workspace @unified-commerce/api",
    "db:status": "npm run db:status --workspace @unified-commerce/api"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
